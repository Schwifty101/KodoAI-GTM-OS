# Names only. Copy to .env and fill in. Numbered keys (_2.._9) are optional extras.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
APIFY_API_KEY=
HUNTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
SERP_API_KEY=
SERP_PROVIDER=serper
GOOGLE_OAUTH_CLIENT_FILE=
# Optional sending config (defaults in gtm/config.py)
DAILY_CAP=
RAMP_START=
RAMP_STEP=
PAUSE_BOUNCE_RATE=
PAUSE_MIN_SENDS=
SIGNAL_MAX_AGE_DAYS=
# Footer values: empty means not appended
POSTAL_ADDRESS=
AD_DISCLOSURE=
OPT_OUT_LINE=
